# 操作系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
*.swp
*.sw?
.idea/
.vscode/

# 万一被误写入的凭据类文件（双重保险）
*.key
*.pem
secrets.*
.env
.env.*

# 本机私有区（不入库）：kit 自身的评审稿 / 草稿 / 含真实路径的一次性说明
# 规则出处见 README「目录约定说明」（不要加没有文档的规则）
/_local/

# 别人用了这个 kit 之后产生的运行时副本
.installed-by-agent-memory-kit

# git提交信息
git-commit-msg.txt

# ⚠️ 不要在这里加 .agents —— memory-template/.agents/ 是骨架本体，
#    被忽略后会提交不进仓库，clone 下来的人拿到的是残缺模板。
